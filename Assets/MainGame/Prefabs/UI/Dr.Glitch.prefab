--- !u!114 &8840804286440040732
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1484817188981986670}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e85e33e43dc28e646a8dc272618f49a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DoctorDialogController
  m_DialogText: {fileID: 8227046991881271309}
  m_HappyDialogs:
  - dialogText: Bienvenue! Prepare to fail!
    audioClip: {fileID: 8300000, guid: 77f5b4106d2ceb84186c0cfcf50d7352, type: 3}
  - dialogText: Sacrebleu! You actually came zis far? How delightfully foolish!
    audioClip: {fileID: 8300000, guid: 05fb1510f93e89341a3f0976b5028765, type: 3}
  - dialogText: My traps are magnifique!
    audioClip: {fileID: 8300000, guid: 7d0ba8652872cf54ba6f6430909f5ae8, type: 3}
  - dialogText: "According to my calculations, your chances of success are... tr\xE8s
      terrible"
    audioClip: {fileID: 8300000, guid: 421179f0bc8f02b4b822269314206473, type: 3}
  - dialogText: Oho! Did you not see zat coming?
    audioClip: {fileID: 8300000, guid: 1b34e022ee8c21845b6a3fe03f5fe0c8, type: 3}
  - dialogText: Mon ami, you jump like a frightened baguette!
    audioClip: {fileID: 8300000, guid: fed4d9b8fc50af34a9f452f770b00839, type: 3}
  - dialogText: Zese obstacles are handcrafted with evil perfection!
    audioClip: {fileID: 8300000, guid: f48c0b24090cbec40a75fd56907885fe, type: 3}
  - dialogText: Please, continue triggering my traps.
    audioClip: {fileID: 8300000, guid: 0dfc3d6c361a35c4fb81e75de9578198, type: 3}
  - dialogText: You are providing excellent research data.
    audioClip: {fileID: 8300000, guid: a44c285f97b928c4487376328d7d26c8, type: 3}
  - dialogText: Even my laboratory hamster performs better under pressure.
    audioClip: {fileID: 8300000, guid: c5256d98e46f84847a9d82e9cd7fb7e8, type: 3}
  - dialogText: Mon dieu, zat was spectacularly unsuccessful
    audioClip: {fileID: 8300000, guid: 37a5a169a0ba33247af79780d0fc4f14, type: 3}
  - dialogText: A predictable mistake!
    audioClip: {fileID: 8300000, guid: c56dfc69d52e79d4cb3e9a24ff2d573a, type: 3}
  - dialogText: Please, continue failing.
    audioClip: {fileID: 8300000, guid: b4157aa04a39a354f88f562b8c5bf55b, type: 3}
  - dialogText: Zis is entertaining!
    audioClip: {fileID: 8300000, guid: 7d69a174d62a9284f88076d31c969dc2, type: 3}
  - dialogText: Haha! As expected!
    audioClip: {fileID: 8300000, guid: 63b0e14ee60d0f54c96ba8e67e6acfe8, type: 3}
  - dialogText: Back to ze checkpoint!
    audioClip: {fileID: 8300000, guid: caf6e09ae9545b64584b7d6c579fff11, type: 3}
  - dialogText: Try again, little hero
    audioClip: {fileID: 8300000, guid: 307699f376413674dace8b869d9dc03c, type: 3}
  m_SadDialogs:
  - dialogText: Wait... what?!
    audioClip: {fileID: 8300000, guid: 2259a001dc0cded48b625259c59d34da, type: 3}
  - dialogText: Non! Not possible!
    audioClip: {fileID: 8300000, guid: c178904a2b2e500459f4353336a9cd77, type: 3}
  - dialogText: Impossible!
    audioClip: {fileID: 8300000, guid: 06d2492db8b7cde43ad409e34149541f, type: 3}
  - dialogText: Mon dieu... zis is bad!
    audioClip: {fileID: 8300000, guid: 042ee509f9bddcf42b66dd91e0e3a0d0, type: 3}
  - dialogText: Zis changes nuzzing
    audioClip: {fileID: 8300000, guid: dd090ac2c731fd64bb3784092de5fa01, type: 3}
  - dialogText: You got lucky!
    audioClip: {fileID: 8300000, guid: 3a0bf24b7a4758b47b19f104f95be7fe, type: 3}
  - dialogText: I underestimated you...
    audioClip: {fileID: 8300000, guid: d3eece99cade30e4c99ad34085f2da1f, type: 3}
  - dialogText: You cheated physics somehow!
    audioClip: {fileID: 8300000, guid: 8c5f9484e37d63f4296b62de950a00f9, type: 3}
  - dialogText: How did you survive?!
    audioClip: {fileID: 8300000, guid: 7b7fb7fc771086e41bd629ca9f4e459e, type: 3}
  - dialogText: You broke my predictions!
    audioClip: {fileID: 8300000, guid: 067e832969dcb1b4c863259724290c8f, type: 3}
  - dialogText: Sacrebleu!
    audioClip: {fileID: 8300000, guid: 281940cf00cfe624a8ccee45661a2e08, type: 3}
  - dialogText: I refuse to accept zis!
    audioClip: {fileID: 8300000, guid: fafd63c76024b5c41ab3dbc27821dc55, type: 3}
  - dialogText: Back to ze drawing board!
    audioClip: {fileID: 8300000, guid: b441c730a5690ac4ba04041ae2842da2, type: 3}
  - dialogText: Curse your platforming skills!
    audioClip: {fileID: 8300000, guid: bcc31a86e5b13244b8788cdcd4a1cefd, type: 3}
  - dialogText: Sacrebleu! How?!
    audioClip: {fileID: 8300000, guid: 1984eafa658e37345ab530700beaf60a, type: 3}
