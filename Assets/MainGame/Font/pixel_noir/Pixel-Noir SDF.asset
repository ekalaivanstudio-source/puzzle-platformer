      3 \u90E8\u5206\n  \u5728\u672C\u7AE0\u8282\u4E2D\uFF0C\u60A8\u5C06\u5B66\u4E60\u5982\u4F55\u542F\u52A8\u6CF5\u7684\u64CD\u4F5C\u9762\u677F\u3002
      \u5B8C\u6210\u6B64\u7AE0\u8282\u540E\uFF0C\u60A8\u5C06\u80FD\u591F\u638C\u63E1\u6CF5\u7535\u7F06\u8FDE\u63A5\u5E76\u5B66\u4E60\u5728\u542F\u52A8\u6CF5\u4E4B\u524D\u5F00\u542F\u6CF5\u9762\u677F\u3002
      \n \u70B9\u51FB\"\"\u4E0B\u4E00\u6B65\"\"\u5F00\u59CB\u5B66\u4E60\u3002\",C_L_S023,~,,Heading,Chinese,,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\u901A\u8FC7\u89E6\u6478\u69FD\u7F50\u8F66\u64CD\u4F5C\u7BB1\u4FA7\u7684\u7A81\u51FA\u663E\u793A\u7684\u95E8
      \u6253\u5F00\u7535\u6E90\u7BB1\u9762\u677F\u95E8\u3002,C_L_S024,~,,\u6307\u5357,\"\u6B22\u8FCE\u6765\u5230\u65B0\u624B\u5165\u95E8\u6A21\u5757\uFF01\u5728\u672C\u6A21\u5757\u4E2D\uFF0C\u60A8\u5C06\u5B66\u4E60\u5982\u4F55\u4E0E\u865A\u62DF\u73B0\u5B9E\u73AF\u5883\u4E2D\u7684\u7269\u4F53\u8FDB\u884C\u57FA\u672C\u4EA4\u4E92\u3002\n
      \n \u60A8\u773C\u524D\u7684\u5361\u7247\u662F\u64CD\u4F5C\u6307\u5357\u5361\uFF0C\u5B83\u5C06\u5F15\u5BFC\u60A8\u5B8C\u6210\u6574\u4E2A\u5B66\u4E60\u8FC7\u7A0B\u3002\u5361\u7247\u53F3\u4E0B\u89D2\u6709\u4E00\u4E2A\u201C\u4E0B\u4E00\u6B65\u201D\u6309\u94AE\u3002\u70B9\u51FB\u6B64\u6309\u94AE\u5373\u53EF\u7EE7\u7EED\u5B66\u4E60\u4E0B\u4E00\u6761\u64CD\u4F5C\u6307\u5357\u3002\",C_O_S01,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\u901A\u8FC7\u89E6\u6478\u7A81\u51FA\u663E\u793A\u7684\u95E8\u6253\u5F00\u7535\u7F06\u7BB1\uFF0C\u5C06\u7535\u7F06\u9012\u7ED9\u62BC\u8FD0\u5458\u3002
      \u6CE8\u610F\uFF1A \u642C\u8FD0\u7535\u7F06\u65F6\uFF0C\u8BF7\u52FF\u5C06\u63D2\u5934\u9876\u7AEF\u5728\u5730\u9762\u4E0A\u62D6\u884C,C_L_S025,~,,\u6309\u94AE\u89E6\u6478,\"\u201C\u6211\u4EEC\u5148\u6765\u5B66\u4E60\u5982\u4F55\u5728\u8FD9\u4E2A\u73AF\u5883\u4E2D\u62FE\u53D6\u548C\u653E\u7F6E\u7269\u4F53\u3002\n
      \n \u5F00\u59CB\u4E4B\u524D\uFF0C\u8BF7\u8BB0\u4F4F\uFF0C\u5F53\u4F60\u7684\u89C6\u7EBF\u79BB\u5F00\u8BF4\u660E\u5361\u65F6\uFF0C\u5C4F\u5E55\u4E0A\u4F1A\u51FA\u73B0\u4E00\u4E2A\u84DD\u8272\u7684\u7BAD\u5934\u3002\u5F53\u4F60\u9700\u8981\u53C2\u8003\u8BF4\u660E\u5361\u65F6\uFF0C\u8FD9\u4E2A\u7BAD\u5934\u4F1A\u6307\u5F15\u4F60\u627E\u5230\u5B83\u3002\u5728\u6574\u4E2A\u5B66\u4E60\u8FC7\u7A0B\u4E2D\uFF0C\u5F53\u4F60\u7684\u89C6\u7EBF\u79BB\u5F00\u76EE\u6807\u7269\u4F53\u65F6\uFF0C\u8FD9\u4E2A\u7BAD\u5934\u4F1A\u6307\u5411\u4F60\u9700\u8981\u4E0E\u4E4B\u4E92\u52A8\u7684\u7269\u4F53\u3002\u8FD9\u662F\u4E00\u79CD\u65B9\u4FBF\u7684\u4E13\u6CE8\u548C\u5BFC\u822A\u65B9\u5F0F\u3002\n
      \n \u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u5F00\u59CB\u5B66\u4E60\u3002\u201D\",C_O_S02,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\u9A8C\u8BC1\u7535\u7BB1\u63A7\u5236\u9762\u677F\u662F\u5426\u5904\u4E8E\u5BC6\u5C01\u72B6\u6001\u3002\u5982\u679C\u53D1\u73B0\u5F02\u5E38\uFF0C\u8BF7\u7ACB\u5373\u901A\u77E5\u6797\u5FB7\u914D\u9001\u7BA1\u7406\u4EBA\u5458\u5E76\u7B49\u5F85\u6307\u793A,C_L_S026,~,,\u62FE\u53D6\u4E0E\u653E\u7F6E,\u73B0\u5728\u8BF7\u6CE8\u610F\u56FE\u4E2D\u4EE5\u7EFF\u8272\u9AD8\u4EAE\u663E\u793A\u7684\u76EE\u6807\u7269\u4F53\uFF08\u6273\u624B\uFF09\u3002\u63A5\u4E0B\u6765\u60A8\u5C06\u5B66\u4E60\u5982\u4F55\u62FE\u53D6\u548C\u653E\u7F6E\u6B64\u7269\u4F53\u3002\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u7EE7\u7EED\u3002,C_O_S03,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\u9A8C\u8BC1\u7535\u6E90\u63D2\u5934\u662F\u5426\u5904\u4E8E\u5BC6\u5C01\u72B6\u6001\u3002\u5982\u679C\u53D1\u73B0\u5F02\u5E38\uFF0C\u8BF7\u7ACB\u5373\u901A\u77E5\u6797\u5FB7\u914D\u9001\u7BA1\u7406\u4EBA\u5458\u5E76\u7B49\u5F85\u6307\u793A\u3002,C_L_S027,~,,\u62FE\u53D6\u4E0E\u653E\u7F6E,\u73B0\u5728\u62FF\u8D77\u6273\u624B\uFF0C\u628A\u5B83\u653E\u5728\u9EC4\u8272\u9AD8\u4EAE\u533A\u57DF\u5185\u3002\u8BB0\u4F4F\uFF0C\u4EFB\u4F55\u88AB\u62FF\u8D77\u7684\u7269\u54C1\u90FD\u4F1A\u88AB\u81EA\u52A8\u653E\u7F6E\u5728\u9EC4\u8272\u9AD8\u4EAE\u533A\u57DF\u5185\u3002,C_O_S04,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\"\u8FDE\u63A5\u9632\u89E6\u7535\u5730\u7EBF\uFF0C\u628A\u63A5\u5730\u7EBF\u76D8\u7684\u7EBF\u53D6\u51FA\uFF0C\u63A5\u5230\u5BA2\u6237\u50A8\u7F50\u5BF9\u5E94\u7684\u63A5\u5730\u5904\uFF08\u672A\u63A5\u597D\u62A5\u8B66\u706F\u4E0D\u4EAE\uFF09\u3002\n
      \u6CE8\u610F\uFF01\uFF01\uFF01 \n \u63A5\u5730\u7EBF\u4E0D\u53EF\u4EE5\u4E0E\u5145\u88C5\u8F6F\u7BA1\u4EA4\u53C9\u3001\u4E0D\u7ECF\u8FC7\u6392\u653E\u53E3\uFF0C\u907F\u514D\u63A5\u5730\u7EBF\u88AB\u51BB\u88C2\u3002
      \n \u4E0E\u57F9\u8BAD\u6240\u793A\u4E0D\u540C\uFF0C\u5728\u56FD\u5185\uFF0C\u63A5\u5730\u7EBF\u5939\u4E00\u822C\u63A5\u5230\u50A8\u7F50\u5145\u88C5\u9600\u7684\u652F\u67B6\u4E0A\u3002\",C_L_S028,~,,\u62FE\u53D6\u4E0E\u653E\u7F6E,\u505A\u5F97\u597D\uFF01\u60A8\u5DF2\u6210\u529F\u5B66\u4F1A\u5982\u4F55\u901A\u8FC7\u62FE\u53D6\u548C\u653E\u7F6E\u64CD\u4F5C\u4E0E\u6211\u4EEC\u7684\u7269\u4F53\u8FDB\u884C\u4EA4\u4E92\u3002\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u7EE7\u7EED\u3002,C_O_S05,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\u73B0\u5728\u6211\u4EEC\u9700\u8981\u6267\u884C\u6F0F\u7535\u65AD\u8DEF\u529F\u80FD\u6D4B\u8BD5\u3002\u89E6\u6478\u5F00\u5173\u76D2\u95E8\u5C06\u5176\u6253\u5F00\u3002,C_L_S029,~,,\u6253\u5F00\u4E0E\u5173\u95ED,\u73B0\u5728\u6211\u4EEC\u6765\u5B66\u4E60\u5982\u4F55\u6253\u5F00\u548C\u5173\u95ED\u76D2\u5B50\u3002\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u5F00\u59CB\u5B66\u4E60\u3002,C_O_S06,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\"\u73B0\u5728\u6293\u4F4F\u5E76\u6253\u5F00\u7535\u6E90\u5F00\u5173\u3002\n 
      \n \u6CE8\u610F\n \n \uFF081\uFF09 \u5982\u679C\u6309\u4E0B\u6CF5\u542F\u52A8\u6309\u94AE\u540E\uFF0C\u6CF5\u6CA1\u6709\u542F\u52A8\uFF0C\u8BF7\u7ACB\u5373\u901A\u77E5\u5BA2\u6237\u73B0\u573A\u3002
      \n \uFF082\uFF09 \u8BF7\u52FF\u6253\u5F00\u6216\u68C0\u67E5\u63A7\u5236\u9762\u677F\u8FDE\u63A5\u3002\u53EA\u6709\u5728\u83B7\u5F97\u5408\u683C\u7535\u5DE5\u7684\u8BB8\u53EF\u540E\u624D\u80FD\u542F\u52A8\u6CF5\u3002\n
      \uFF083\uFF09 \u672A\u7ECF\u5141\u8BB8\uFF0C\u8BF7\u52FF\u8BA9\u5BA2\u6237\u7535\u5DE5\u7BE1\u6539\u6211\u4EEC\u7684\u69FD\u7F50\u8F66\u7535\u6C14\u5E03\u7F6E\u3002\n
      \uFF084\uFF09 \u542F\u52A8\u540E\uFF0C\u5982\u679C\u6CF5\u51FA\u73B0\u5F02\u5E38\uFF0C\u8BF7\u6309\u4E0B\u6CF5\u9762\u677F\u4E0A\u7684\u7D27\u6025\u6309\u94AE\u3002\",C_L_S030,~,,\u6253\u5F00\u4E0E\u5173\u95ED,\u627E\u5230\u84DD\u8272\u7BAD\u5934\u6307\u793A\u7684\u4E2A\u4EBA\u9632\u62A4\u88C5\u5907\u7BB1\u3002\u627E\u5230\u540E\uFF0C\u6293\u4F4F\u7EFF\u8272\u9AD8\u4EAE\u663E\u793A\u7684\u7BB1\u95E8\u6253\u5F00\u7BB1\u5B50\u3002,C_O_S07,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\"\u5BF9\u4E8E\u6F0F\u7535\u65AD\u8DEF\u529F\u80FD\u6D4B\u8BD5\uFF0C\u8BF7\u6309\u6D4B\u8BD5\u6309\u94AE\uFF08
      T \u6309\u94AE\uFF09\u3002 \n \u6CE8\u610F - \u8BF7\u6CE8\u610F\uFF0C\u5982\u679C\u6F0F\u7535\u65AD\u8DEF\u529F\u80FD\u6D4B\u8BD5\u6CA1\u6709\u8D77\u8DF3\uFF0C\u53F8\u673A\u5E94\u81F4\u7535\u5E76\u901A\u77E5\u914D\u9001\u7BA1\u7406\u4EBA\u5458\u5E76\u6309\u7167\u6307\u793A\u8FDB\u884C\u4F5C\u4E1A\u3002\",C_L_S031,~,,\u6253\u5F00\u4E0E\u5173\u95ED,\u73B0\u5728\u628A\u95E8\u5173\u4E0A\u3002,C_O_S08,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\u6293\u4F4F\u63D2\u5934\u9876\u90E8\uFF0C\u5C06\u63D2\u5934\u63D2\u5165\u63D2\u5EA7\u3002\u5728\u6267\u884C\u6B64\u52A8\u4F5C\u4E4B\u524D\uFF0C\u8BF7\u786E\u4FDD\u63D2\u5EA7\u65AD\u8DEF\u5668\u4F4D\u7F6E\u5E94\u5904\u4E8E\u5173\u95ED\u72B6\u6001\uFF0C\u5E76\u4E14\u6CA1\u6709\u672A\u7ECF\u6388\u6743\u7684\u4EBA\u5458\u9760\u8FD1\u69FD\u7F50\u8F66\u3002,C_L_S032,~,,\u6253\u5F00\u4E0E\u5173\u95ED,\u505A\u5F97\u597D\uFF01\u4F60\u73B0\u5728\u5DF2\u7ECF\u5B66\u4F1A\u4E86\u5982\u4F55\u5F00\u5173\u95E8\u3002\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u7EE7\u7EED\u3002,C_O_S09,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\u6293\u4F4F\u63D2\u5934\u9876\u90E8\uFF0C\u5C06\u63D2\u5934\u4FDD\u9669\u9501\u9501\u5B9A\u5728\u63D2\u5EA7\u4E2D\u3002,C_L_S033,~,,\u9600\u95E8\u65CB\u8F6C,\u73B0\u5728\u60A8\u5C06\u5B66\u4E60\u5982\u4F55\u6253\u5F00\u548C\u5173\u95ED\u9600\u95E8\u3002\u53F3\u4FA7\u7684\u89C6\u9891\u5C06\u6F14\u793A\u9600\u95E8\u7684\u6253\u5F00\u548C\u5173\u95ED\u64CD\u4F5C\u3002\u89C2\u770B\u89C6\u9891\u5E76\u8FDB\u884C\u64CD\u4F5C\u3002\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u5F00\u59CB\u3002,C_O_S10,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\u7AD9\u5728\u914D\u7535\u7EBF\u7684\u4E00\u4FA7\u6253\u5F00\u7535\u6E90\u5F00\u5173\u3002,C_L_S034,~,,\u9600\u95E8\u65CB\u8F6C,\u9006\u65F6\u9488\u65CB\u8F6C\u9600\u95E8\u5373\u53EF\u6253\u5F00\u3002,C_O_S11,~\r\n\u6CF5\u9762\u677F\u7535\u7F06\u8BBE\u7F6E,\"\u68C0\u67E5\u7535\u7BB1\u9762\u677F\u662F\u5426\u4EAE\u706F\u6709\u7535\u3002\u68C0\u67E5\u7535\u7BB1\u9762\u677F\u4E2D\u7684\u4EE5\u4E0B\u9879\u76EE\u662F\u5426\u5904\u4E8E\u6253\u5F00\u72B6\u6001\uFF1A\n
      1. \u7CFB\u7EDF\u6307\u793A\u706F\u5E94\u4EAE\u8D77\u3002 \n 2. \u9884\u51B7\u6307\u793A\u706F\u5E94\u5F00\u542F
      \n 3. \u5C0F\u578B\u65AD\u8DEF\u5668\u5E94\u5F00\u542F\n 4. \u8FC7\u8F7D\u7EE7\u7535\u5668
      \u5E94\u5F00\u542F\n \u5982\u679C\u5B8C\u6210\uFF0C\u8BF7\u6309\u68C0\u67E5\u540E\u7684\u6309\u94AE\u3002\u5982\u679C\u4EFB\u4F55\u6307\u793A\u706F\u4E0D\u4EAE\uFF0C\u53F8\u673A\u5E94\u81F4\u7535\u5E76\u901A\u77E5\u914D\u9001\u7BA1\u7406\u4EBA\u5458\u5E76\u6309\u7167\u6307\u793A\u8FDB\u884C\u4F5C\",C_L_S035,~,,\u9600\u95E8\u65CB\u8F6C,\u505A\u5F97\u597D\uFF01\u73B0\u5728\u987A\u65F6\u9488\u65CB\u8F6C\u9600\u95E8\u5C06\u5176\u5173\u95ED\u3002,C_O_S12,~\r\n\u8F6F\u7BA1\u5439\u626B,\"\u7B2C
      4 \u90E8\u5206\n \u5728\u672C\u7AE0\u8282\u4E2D\uFF0C\u60A8\u5C06\u5B66\u4E60\u5982\u4F55\u8FDB\u884C\u8F6F\u7BA1\u5439\u626B\u3002\u8F6F\u7BA1\u5439\u626B\u662F\u4E3A\u4E86\u5439\u6389\u8F6F\u7BA1\u4E2D\u7684\u5F02\u7269\uFF0C\u56E0\u4E3A\u5B83\u53EF\u80FD\u542B\u6709\u6C34\u6C14\u6216\u6C34\u73E0\u3002\n
      \u5B8C\u6210\u6B64\u7AE0\u8282\u540E\uFF0C\u60A8\u5C06\u80FD\u591F\u6B63\u786E\u8BB0\u4F4F\u5E76\u5728\u4EA7\u54C1\u88C5\u5378\u4E4B\u524D\u8FDB\u884C\u8F6F\u7BA1\u6E05\u6D17\u3002
      \n \u5355\u51FB \u201C\u4E0B\u4E00\u6B65\u201D \u5F00\u59CB\u5B66\u4E60\u3002\",C_L_S036,~,,\u9600\u95E8\u65CB\u8F6C,\u505A\u5F97\u597D\uFF01\u60A8\u5DF2\u6210\u529F\u5B66\u4E60\u9600\u95E8\u4EA4\u4E92\u3002\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u7EE7\u7EED\u3002,C_O_S13,~\r\n\u8F6F\u7BA1\u5439\u626B,\u8BF7\u6CE8\u610F\uFF0C\u8FD0\u8F93\u69FD\u7F50\u8F66\u9600\u95E8\u7684\u5B9E\u9645\u4F4D\u7F6E\u53EF\u80FD\u7565\u6709\u4E0D\u540C\uFF0C\u64CD\u4F5C\u9600\u95E8\u65F6\u52A1\u5FC5\u67E5\u770B\u9600\u95E8\u6807\u7B7E\u3002,C_L_S037,,,\u4F20\u9001,\u73B0\u5728\u4F60\u5C06\u5B66\u4E60\u5982\u4F55\u77AC\u95F4\u79FB\u52A8\u3002\u53F3\u4FA7\u7684\u89C6\u9891\u5C06\u6F14\u793A\u5982\u4F55\u8FDB\u884C\u77AC\u95F4\u79FB\u52A8\u3002\u89C2\u770B\u89C6\u9891\u5E76\u8FDB\u884C\u64CD\u4F5C\u3002\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u5F00\u59CB\u3002,C_O_S14,~\r\n\u8F6F\u7BA1\u5439\u626B,\u6253\u5F00\u50A8\u7F50\u6B8B\u6DB2\u9600,C_L_S038,~,,\u4F20\u9001,\u5982\u89C6\u9891\u6240\u793A\uFF0C\u5728\u8FD9\u4E2A\u623F\u95F4\u91CC\u7EC3\u4E60\u4F20\u9001\uFF0C\u76F4\u5230\u4F60\u719F\u7EC3\u638C\u63E1\u4E3A\u6B62\u3002\u5B8C\u6210\u540E\uFF0C\u70B9\u51FB\u4E0B\u4E00\u6B65\u3002,C_O_S15,~\r\n\u8F6F\u7BA1\u5439\u626B,\u6253\u5F00\u7A81\u51FA\u663E\u793A\u7684\u69FD\u8F66\u7D27\u6025\u5207\u65AD\u9600\u3002\u9006\u65F6\u9488\u65CB\u8F6C\u6253\u5F00\uFF0C,C_L_S039,~,,\u4F20\u9001,\u592A\u68D2\u4E86\uFF01\u4F60\u5DF2\u7ECF\u5B66\u4F1A\u4E86\u77AC\u95F4\u79FB\u52A8\u3002\u70B9\u51FB\u4E0B\u4E00\u6B65\u7EE7\u7EED\u3002,C_O_S16,~\r\n\u8F6F\u7BA1\u5439\u626B,\u6253\u5F00\u69FD\u7F50\u8F66\u6DB2\u4F53\u51FA\u53E3\u9600,C_L_S040,~,,\u5207\u6362\u89C6\u89D2,\u73B0\u5728\u4F60\u5C06\u5B66\u4E60\u5982\u4F55\u5DE6\u53F3\u79FB\u52A8\u89C6\u89D2\u3002\u89C2\u770B\u53F3\u4FA7\u7684\u89C6\u9891\u6F14\u793A\u3002\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u5F00\u59CB\u3002,C_O_S17,~\r\n\u8F6F\u7BA1\u5439\u626B,\u73B0\u5728\u9006\u65F6\u9488\u65CB\u8F6C\u4E24\u5708\u5DE6\u53F3\u6253\u5F00\u69FD\u7F50\u8F66\u4E2D\u56DE\u6D41\u9600\u3002,C_L_S041,~,,\u5207\u6362\u89C6\u89D2,\u5982\u89C6\u9891\u6240\u793A\uFF0C\u7EC3\u4E60\u5DE6\u53F3\u79FB\u52A8\u89C6\u89D2\uFF0C\u76F4\u5230\u611F\u89C9\u8212\u9002\u4E3A\u6B62\u3002\u5B8C\u6210\u540E\uFF0C\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u3002,C_O_S18,~\r\n\u8F6F\u7BA1\u5439\u626B,\u5728\u5B9E\u9645\u4E16\u754C\u4E2D\uFF0C\u6253\u5F00\u5BA2\u6237\u50A8\u69FD\u5145\u88C5\u53E3\u6B8B\u6DB2\u9600\u7528\u69FD\u8F66\u5185\u7684\u6C14\u4F53\u618B\u538B\u5439\u626B\u8F6F\u7BA1\u81F3\u5C113\u6B21\uFF0C\u6BCF\u6B21\u8F6F\u7BA1\u5145\u538B\u76F4\u81F3\u548C\u69FD\u8F66\u7684\u6C14\u76F8\u538B\u529B\u4E00\u81F4\uFF0C\u518D\u9759\u7F6E10\u79D2\u949F\uFF0C\u653E\u7A7A\u538B\u529B\u81F3\u4FDD\u8BC1\u6709\u5FAE\u6B63\u538B\uFF08\u7EA60.1\u516C\u65A4\uFF0C\u624B\u80FD\u611F\u89C9\u5230\u6709\u6C14\uFF09\u3002,C_L_S042,~,,\u5207\u6362\u89C6\u89D2,\u606D\u559C\uFF01\u60A8\u5DF2\u6210\u529F\u5B8C\u6210\u5165\u95E8\u6D41\u7A0B\u3002\u6211\u4EEC\u5E0C\u671B\u60A8\u73B0\u5728\u80FD\u591F\u81EA\u4FE1\u5730\u5728\u865A\u62DF\u73B0\u5B9E\u73AF\u5883\u4E2D\u4E0E\u7269\u4F53\u8FDB\u884C\u57FA\u672C\u4EA4\u4E92\u3002\u505A\u5F97\u597D\uFF01,C_O_S19,~\r\n\u8F6F\u7BA1\u5439\u626B,\"\u89C2\u5BDF\u4ECE\u8F6F\u7BA1\u4E2D\u6D41\u51FA\u7684\u6C14\u4F53\u3002\u7531\u4E8E\u60A8\u5DF2\u5B8C\u6210\u5439\u626B\uFF0C\u56E0\u6B64\u8BF7\u5173\u95ED\u7A81\u51FA\u663E\u793A\u7684\u50A8\u7F50\u5904\u7684\u6B8B\u6DB2\u9600\u3002\n
      \u6CE8\u610F\uFF1A \u5728\u8F6F\u7BA1\u5439\u626B\u8FC7\u7A0B\u4E2D\uFF0C\u8BF7\u52FF\u8DE8\u8D8A\u8F6F\u7BA1\u3002\",C_L_S043,~,,\u5207\u6362\u89C6\u89D2,\u606D\u559C\uFF01\u60A8\u5DF2\u6210\u529F\u5B8C\u6210\u5165\u95E8\u6D41\u7A0B\u3002\u6211\u4EEC\u5E0C\u671B\u60A8\u73B0\u5728\u80FD\u591F\u81EA\u4FE1\u5730\u5728\u865A\u62DF\u73B0\u5B9E\u73AF\u5883\u4E2D\u4E0E\u7269\u4F53\u8FDB\u884C\u57FA\u672C\u4EA4\u4E92\u3002\u505A\u5F97\u597D\uFF01,C_O_S19,\r\n\u6CF5\u51B7\u5374,\"\u7B2C
      5 \u90E8\u5206\n  \u5728\u672C\u7AE0\u8282\u4E2D\uFF0C\u60A8\u5C06\u5B66\u4E60\u5982\u4F55\u51B7\u5374\u6CF5\u3002
      \u5B8C\u6210\u6B64\u90E8\u5206\u540E\uFF0C\u60A8\u5C06\u80FD\u591F\u5728\u4EA7\u54C1\u88C5\u5378\u4E4B\u524D\u6B63\u786E\u5730\u6267\u884C\u51B7\u6CF5\u64CD\u4F5C\u3002
      \n \n \u5355\u51FB \u201C\u4E0B\u4E00\u6B65\u201D \u5F00\u59CB\u5B66\u4E60\u3002\",C_L_S044,~,,,,,\r\n\u6CF5\u51B7\u5374,\u6253\u5F00\u6CF5\u6DB2\u4F53\u8FDB\u53E3\u9600,C_L_S045,~,,,,,\r\n\u6CF5\u51B7\u5374,\u6253\u5F00\u6D41\u91CF\u8BA1\uFF0C\u7136\u540E\u6309\u4E24\u6B21\u6D41\u91CF\u8BA1\u4E0A\u7684\u201C\u6E05\u9664\u201D\u6309\u94AE\uFF0C\u5C06\u8BFB\u6570\u91CD\u7F6E\u4E3A\u201C0\u201D,C_L_S046,~,,Evaluation,,,\r\n\u6CF5\u51B7\u5374,\u73B0\u5728\uFF0C\u5728\u6DB2\u4F53\u6D41\u5165\u6CF5\u540E\uFF0C\u5B8C\u5168\u6253\u5F00\u56DE\u6D41\u9600,C_L_S047,~,,Heading,Content,VO,~\r\n\u6CF5\u51B7\u5374,\u6253\u5F00\u50A8\u7F50\u9876\u90E8\u7684\u5145\u88C5\u9600\u3002,C_L_S048,~,,,\"\u6B22\u8FCE\u6765\u5230VR\u57F9\u8BAD\u8BC4\u4F30\u6A21\u5757\uFF01\n
      \n \u51C6\u5907\u597D\u4F53\u9A8C\u6C89\u6D78\u5F0F\u8BAD\u7EC3\uFF0C\u60A8\u5C06\u4F7F\u7528\u6DB2\u4F53\u8F93\u9001\u6CF5\uFF0C\u5728\u4F4E\u538B\u6CB9\u7F50\u8F66\u4E2D\u5C06\u6DB2\u4F53\u503E\u5012\u81F3\u50A8\u7F50\u7684\u8FC7\u7A0B\u4E2D\uFF0C\u5C55\u793A\u60A8\u7684\u6280\u80FD\u3002\u672C\u6B21\u8BC4\u4F30\u5C06\u5C55\u73B0\u60A8\u81EA\u4FE1\u5730\u5B8C\u6210\u8FD9\u9879\u5173\u952E\u4EFB\u52A1\u7684\u4E13\u4E1A\u80FD\u529B\u3002\u8BF7\u6CE8\u610F\uFF0C\u60A8\u5728\u8BC4\u4F30\u8FC7\u7A0B\u4E2D\u67092\u5206\u949F\u7684\u65F6\u95F4\u5B8C\u6210\u6BCF\u9879\u4EFB\u52A1\u3002\u5982\u679C\u8D85\u8FC72\u5206\u949F\uFF0C\u8BC4\u4F30\u6A21\u5F0F\u5C06\u81EA\u52A8\u5173\u95ED\u3002\",C_E_S01,~\r\n\u6CF5\u51B7\u5374,\u5BC6\u5207\u5173\u6CE8\u69FD\u7F50\u8F66\u5185\u7F50\u538B\u529B\u8868\u3002\u786E\u4FDD\u5B83\u4E0D\u8D85\u8FC7
      2.5 \u516C\u65A4\uFF08\u81EA\u589E\u538B\u3001\u4E70\u53EF\u4FDD\u8F66\u9664\u5916\uFF09,C_L_S049,~,,,\"\u5F00\u59CB\u524D\uFF1A\n
      \n - \u8BF7\u786E\u4FDD\u60A8\u8EAB\u5904\u4E00\u4E2A\u4E0D\u53D7\u5E72\u6270\u7684\u73AF\u5883\n
      \n - \u4E3A\u83B7\u5F97\u6700\u4F73\u4F53\u9A8C\uFF0C\u8BF7\u786E\u4FDDVR\u5934\u663E\u4F69\u6234\u8212\u9002\n
      \n - \u8BC4\u4F30\u671F\u95F4\uFF0C\u8BF7\u52FF\u634F\u5408\u6216\u6309\u538BVR\u8BBE\u5907\u4E0A\u7684\u4EFB\u4F55\u83DC\u5355\u9009\u9879\u6216\u5176\u4ED6\u6309\u94AE\n
