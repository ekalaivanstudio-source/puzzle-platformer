    characterSequence: "Heading,Content,VO,~,,welcome content,,Chinese (Simplified
      Mandarin),\r\n\u6B22\u8FCE,\u6B22\u8FCE\u6765\u5230\u6211\u4EEC\u7684\u5B66\u4E60\u6A21\u5757\uFF01\u4ECA\u5929\uFF0C\u60A8\u5C06\u5F00\u59CB\u6C89\u6D78\u5F0F
      VR \u57F9\u8BAD\u4F53\u9A8C\uFF0C\u6307\u5BFC\u60A8\u5B8C\u6210\u4ECE\u4F4E\u538B\u8FD0\u8F93\u69FD\u7F50\u8F66\u5230\u50A8\u7F50\u7684\u5B89\u5168\u9AD8\u6548\u5378\u8D27\u8FC7\u7A0B\u3002
      \u6B64\u865A\u62DF\u57F9\u8BAD\u7ECF\u8FC7\u7CBE\u5FC3\u8BBE\u8BA1\uFF0C\u65E8\u5728\u8BA9\u60A8\u5728\u65E0\u98CE\u9669\u7684\u73AF\u5883\u4E2D\u83B7\u5F97\u5B9E\u8DF5\u7ECF\u9A8C\u3002\u60A8\u5C06\u5B66\u4E60\u57FA\u672C\u6280\u672F\u548C\u6700\u4F73\u5B9E\u8DF5\uFF0C\u786E\u4FDD\u60A8\u83B7\u5F97\u81EA\u4FE1\u5730\u5904\u7406\u8FD9\u9879\u5173\u952E\u4EFB\u52A1\u6240\u9700\u7684\u6280\u80FD\u3002
      \u795D\u60A8\u5B66\u4E60\u6109\u5FEB\uFF01\u5355\u51FB \u4E0B\u4E00\u6B65 \u5F00\u59CB\u3002,C_L_S001,~,,Chinese,,\u4E0B\u4E00\u6B65,\r\n\u8B66\u793A\u5361,\"\u5728\u5F00\u59CB\u4E4B\u524D\uFF0C\u8BF7\u82B1\u70B9\u65F6\u95F4\u786E\u4FDD\u60A8\u5904\u4E8E\u65E0\u5E72\u6270\u7684\u73AF\u5883\u4E2D\u3002\u82E5\u60A8\u6B63\u4F7F\u7528VR\u5934\u90E8\u663E\u793A\u5668\uFF0C\u8BF7\u5C06\u5176\u8C03\u6574\u81F3\u8212\u9002\u72B6\u6001\u4EE5\u83B7\u5F97\u6700\u4F73\u4F53\u9A8C\u3002\u57F9\u8BAD\u8FC7\u7A0B\u4E2D\uFF0C\u8BF7\u907F\u514D\u70B9\u51FB\u6216\u6309\u538BVR\u8BBE\u5907\u4E0A\u7684\u4EFB\u4F55\u83DC\u5355\u9009\u9879\u53CA\u5176\u4ED6\u6309\u94AE\u3002\u5982\u53D1\u751F\u4EFB\u4F55\u8BEF\u70B9\u51FB\u60C5\u51B5\uFF0C\u8BF7\u7ACB\u5373\u8054\u7CFB\u60A8\u7684\u57F9\u8BAD\u534F\u8C03\u5458\u5BFB\u6C42\u5E2E\u52A9\u3002\u82E5\u60A8\u9700\u8981\u63D0\u524D\u7ED3\u675F\u8BAD\u7EC3\uFF0C\u4E5F\u8BF7\u8054\u7CFB\u534F\u8C03\u5458\u534F\u52A9\u5904\u7406\u3002\n
      \u8981\u66F4\u6539\u60A8\u7684\u6A21\u5757\uFF0C\u8BF7\u5355\u51FB\u9876\u90E8\u7684\u4E3B\u9875\u6309\u94AE\u3002\",C_L_S002,~,,\u6B22\u8FCE\u4F53\u9A8C\u6797\u5FB7\u7684\u6C89\u6D78\u5F0FVR\u57F9\u8BAD\uFF01,,\u7528\u65F6,\r\n\u73B0\u573A\u89C4\u5219\u5361,\"\u8BF7\u7262\u8BB0\uFF1A\u8FDB\u884C\u5378\u8D27\u4F5C\u4E1A\u65F6\uFF0C\u5FC5\u987B\u4E25\u683C\u9075\u5B88\u5BA2\u6237\u73B0\u573A\u5236\u5B9A\u7684\u6240\u6709\u89C4\u7AE0\u5236\u5EA6\u3002
      \n \n \u82E5\u60A8\u5DF2\u51C6\u5907\u5C31\u7EEA\uFF0C\u8BF7\u70B9\u51FB\"\"\u4E0B\u4E00\u6B65\"\"\u5F00\u59CB\u64CD\u4F5C\u3002\",C_L_S003,~,,\"\u201C\u5728\u8FD9\u9879\u6C89\u6D78\u5F0F\u57F9\u8BAD\u4E2D\uFF0C\u60A8\u5C06\u5B66\u4E60\u5982\u4F55\u4F7F\u7528\u6DB2\u4F53\u8F93\u9001\u6CF5\u5C06\u4F4E\u6E29\u6DB2\u4F53\u4ECE\u4F4E\u538B\u69FD\u7F50\u8F66\u8F93\u9001\u5230\u50A8\u7F50\u3002\u60A8\u8FD8\u5C06\u901A\u8FC7\u4E00\u4E2A\u7EFC\u5408\u8BC4\u4F30\u6A21\u5757\u6765\u8BC4\u4F30\u60A8\u5728\u6267\u884C\u4EFB\u52A1\u4E2D\u7684\u8868\u73B0\u3002\n
      \n \u5728\u60A8\u5F00\u59CB\u8FD9\u6BB5\u6FC0\u52A8\u4EBA\u5FC3\u4E14\u5BCC\u6709\u6559\u80B2\u610F\u4E49\u7684\u65C5\u7A0B\u4E4B\u524D\uFF0C\u8BF7\u70B9\u51FB\u201C\u4E0B\u4E00\u6B65\u201D\u9009\u62E9\u76F8\u5E94\u7684\u6A21\u5757\u3002\u90A3\u4E48\uFF0C\u8BA9\u6211\u4EEC\u5F00\u59CB\u5427\uFF01\u201D\",,\u5F00\u59CB,\r\n\u5B89\u5168\u51C6\u5907,\"\u7B2C1\u90E8\u5206\n
      \u5728\u672C\u7AE0\u8282\u4E2D\uFF0C\u60A8\u5C06\u5B66\u4E60\u5982\u4F55\u5728\u5F00\u59CB\u8FDB\u884C\u4EA7\u54C1\u88C5\u5378\u4E4B\u524D\u505A\u597D\u5B89\u5168\u51C6\u5907\u3002
      \n \u57F9\u8BAD\u5B8C\u6210\u540E\uFF0C\u60A8\u5C06\u80FD\u591F\u638C\u63E1\u5728\u5378\u8D27\u8FC7\u7A0B\u4E4B\u524D\u7684\u5B89\u5168\u51C6\u5907\u8981\u6C42\u3002\u8FD9\u5305\u62EC\u4E86\u89E3\u8F66\u8F86\u4E0A\u7684\u8F6E\u6321\u548C\u5B89\u5168\u9525\u653E\u7F6E\u7684\u6B63\u786E\u65B9\u6CD5\uFF0C\u4EE5\u53CA\u4F69\u6234\u4E2A\u4EBA\u9632\u62A4\u8BBE\u5907
      \uFF08PPE\uFF09 \u4EE5\u786E\u4FDD\u60A8\u7684\u4EBA\u8EAB\u5B89\u5168\u3002
      \n \u70B9\u51FB\"\"\u4E0B\u4E00\u6B65\"\"\u5F00\u59CB\u5B66\u4E60\u3002\",C_L_S004,~,,,,\u505C\u6B62,\r\n\u5B89\u5168\u51C6\u5907,\u7B2C\u4E00\u6B65\uFF0C\u5C06\u69FD\u7F50\u8F66\u5B89\u5168\u5730\u505C\u653E\u5728\u575A\u5B9E\u7684\u5730\u9762\u4E0A\u3002\u62C9\u4E0A\u624B\u5239\u3002,C_L_S005,~,,\"\u5728\u6B63\u5F0F\u5F00\u59CB\u4E4B\u524D\uFF0C\u8BA9\u6211\u4EEC\u5148\u6765\u4E86\u89E3\u4E00\u4E0B\u8FD9\u4E09\u4E2A\u6A21\u5757\uFF1A\n
      \n \u5165\u95E8\u6A21\u5757\n \n \u5982\u679C\u60A8\u662F VR \u65B0\u624B\u6216\u9700\u8981\u5FEB\u901F\u590D\u4E60\uFF0C\u6B64\u9009\u9879\u5C06\u5F15\u5BFC\u60A8\u4E86\u89E3
      VR \u73AF\u5883\u4E2D\u7684\u57FA\u672C\u4EA4\u4E92\u548C\u63A7\u5236\u3002\u5BF9\u4E8E\u521D\u5B66\u8005\u6765\u8BF4\uFF0C\u8FD9\u662F\u7406\u60F3\u7684\u8D77\u70B9\u3002\n
      \n \u5B66\u4E60\u6A21\u5757\n \n \u51C6\u5907\u597D\u5F00\u59CB\u4E3B\u8981\u4EFB\u52A1\u4E86\u5417\uFF1F\u5982\u679C\u662F\uFF0C\u8BF7\u9009\u62E9\u6B64\u9009\u9879\uFF0C\u5F00\u59CB\u4F7F\u7528\u6DB2\u4F53\u8F93\u9001\u6CF5\u5C06\u4F4E\u6E29\u6DB2\u4F53\u4ECE\u4F4E\u538B\u6CB9\u7F50\u8F93\u9001\u5230\u50A8\u7F50\u7684\u5B9E\u9645\u57F9\u8BAD\u3002\u5728\u5B89\u5168\u7684\u865A\u62DF\u73AF\u5883\u4E2D\u83B7\u5F97\u5B9E\u8DF5\u7ECF\u9A8C\u3002\n
      \n \u8BC4\u4F30\u6A21\u5757\n \n \u5DF2\u7ECF\u5B8C\u6210\u5B66\u4E60\u6A21\u5757\u5E76\u60F3\u6D4B\u8BD5\u60A8\u7684\u6280\u80FD\uFF1F\u5982\u679C\u662F\uFF0C\u8BF7\u9009\u62E9\u6B64\u9009\u9879\u6765\u8BC4\u4F30\u60A8\u7684\u5B66\u4E60\u6210\u679C\u5E76\u5DE9\u56FA\u77E5\u8BC6\u3002\n
      \n \u9009\u62E9\u60A8\u8981\u5F00\u59CB\u7684\u6A21\u5757\uFF0C\u7136\u540E\u70B9\u51FB\u786E\u8BA4\u3002\",,\u786E\u8BA4,\r\n\u5B89\u5168\u51C6\u5907,\"\u5C06\u4E24\u4E2A\u8F6E\u6321\u4E00\u4E00\u62FF\u8D77\uFF0C\u5728\u69FD\u8F66\u53F3\u4E2D\u8F74\u8F6E\u80CE\u7684\u524D\u540E\u65B9\u57AB\u4E0A\u8F6E\u6321\u3002\n
      \u6CE8\u610F\uFF1AVR\u57F9\u8BAD\u4E2D\u7684\u6446\u653E\u4F4D\u7F6E\u4E0E\u5B9E\u9645\u64CD\u4F5C\u6709\u6240\u4E0D\u540C\",C_L_S006,~,,\u8F93\u5165\u60A8\u7684\u8BE6\u7EC6\u4FE1\u606F,,\u70B9\u51FB\u201C\u786E\u8BA4\u201D\u5F00\u59CB\u68C0\u67E5\u50A8\u7F50\u548C\u8FD0\u8F93\u5361\u8F66\u7684\u538B\u529B,\r\n\u5B89\u5168\u51C6\u5907,\u73B0\u5728\u62FF\u8D77\u5B89\u5168\u9525\u5E76\u5C06\u5176\u653E\u7F6E\u5728\u7A81\u51FA\u663E\u793A\u7684\u533A\u57DF\u3002\u8BF7\u6CE8\u610F\uFF0C\u5728\u6B64
      VR \u57F9\u8BAD\u4E2D\uFF0C\u5982\u679C\u5BF9\u4E00\u4E2A\u5B89\u5168\u9525\u6267\u884C\u6B64\u64CD\u4F5C\uFF0C\u5B83\u4F1A\u81EA\u52A8\u5728\u5176\u4ED6\u56DB\u4E2A\u4FA7\u9762\u6446\u653E\u5176\u4ED6\u56DB\u4E2A\u5B89\u5168\u9525\u3002,C_L_S007,~,,,,\u5361\u8F66\u538B\u529B
      < 6 barg \u2014\u2014 \u5DF2\u786E\u8BA4,\r\n\u5B89\u5168\u51C6\u5907,\u73B0\u5728\u6253\u5F00\u7A81\u51FA\u663E\u793A\u7684
