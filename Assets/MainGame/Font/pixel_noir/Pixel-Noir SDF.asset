      80% \u7684\u6DB2\u4F4D\u3002,C_L_S081,~,,,,,\r\n\u5378\u8D27\u5B8C\u6210,\u628A\u6EA2\u6EE1\u9600\u5168\u5F00,C_L_S082,~,,,,,\r\n\u5378\u8D27\u5B8C\u6210,\u5F53\u6DB2\u4F53\u4ECE\u50A8\u7F50\u6EA2\u6EE1\u9600\u6EA2\u51FA\u3001\u8FBE\u5230\u6DB2\u4F4D\u8BA1\u6700\u9AD8\u6807\u8BB0\u6216\u8FDC\u7A0B\u76D1\u63A7\u6DB2\u4F4D\u5230\u8FBE
