      3 \u6B21\uFF0C\u4EE5\u62E7\u7D27\u8FDE\u63A5,C_L_S020,~,,,,,\r\n\u8F6F\u7BA1\u8FDE\u63A5,\u8F6F\u7BA1\u8FDE\u63A5\u7262\u56FA\u3002\u5C06\u94DC\u9524\u653E\u56DE\u5DE5\u5177\u7BB1\u4E2D\u5E76\u5173\u95ED\u3002,C_L_S021,~,,,,,\r\n\u8F6F\u7BA1\u8FDE\u63A5,\u8BF7\u6CE8\u610F\uFF0C\u56FA\u5B9A\u8F6F\u7BA1\u540E\uFF0C\u60A8\u5FC5\u987B\u5728\u4E24\u4E2A\u8F6F\u7BA1\u8FDE\u63A5\u5904\u5B89\u88C5\u9632\u7529\u94FE\u3002
